# Sao chép file mẫu này thành .env.local trong thư mục frontend và chỉnh ở đó.
# Chỉ điền địa chỉ API công khai. Không điền mật khẩu, khóa bí mật hay thông tin đăng nhập cơ sở dữ liệu.

# Trình duyệt trên máy tính: để trống EXPO_PUBLIC_API_URL khi chạy cục bộ.
# Ví dụ: mở app ở http://localhost:8081 thì app gọi backend ở http://localhost:8080.

# iPhone hoặc Android thật: kết nối cùng Wi-Fi với máy tính đang chạy backend.
# Trên Windows, gõ ipconfig và tìm IPv4 Address trong mục Wi-Fi.
# Bỏ dấu # ở đầu dòng ví dụ bên dưới rồi thay 192.168.1.10 bằng IPv4 vừa tìm.
# EXPO_PUBLIC_NATIVE_API_URL=http://192.168.1.10:8080

# Máy ảo Android Studio: dùng dòng này thay cho dòng IP Wi-Fi ở trên.
# EXPO_PUBLIC_NATIVE_API_URL=http://10.0.2.2:8080

# Khi web và điện thoại cùng dùng một backend đã triển khai, đặt địa chỉ chung ở đây.
# Nếu cũng đặt EXPO_PUBLIC_NATIVE_API_URL thì điện thoại và máy ảo ưu tiên địa chỉ riêng đó.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Sau khi đổi .env.local, dừng Expo bằng Ctrl+C rồi chạy lại npx expo start.
