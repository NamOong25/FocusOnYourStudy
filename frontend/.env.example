# Public API origin only. Never put database credentials, passwords or signing keys here.
# Web defaults to the current hostname on port 8080 (localhost stays localhost for cookies).
# Use the shared override when all platforms call the same deployed backend.
# EXPO_PUBLIC_API_URL=https://api.example.com
# Local phone: set the computer's Wi-Fi IP here. Android emulator: http://10.0.2.2:8080.
# EXPO_PUBLIC_NATIVE_API_URL=http://192.168.1.10:8080
