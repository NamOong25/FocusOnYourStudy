{
  "expo": {
    "name": "FocusYourStudy",
    "slug": "quan-ly-hoc-tap",
    "version": "0.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "focusyourstudy",
    "icon": "./assets/logo.png",
    "backgroundColor": "#F4FAFD",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.focusyourstudy.app",
      "permissions": ["android.permission.VIBRATE"],
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png",
      "name": "FocusYourStudy"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b1263f8f-a1e2-4ea5-8e86-a19cd312b80f"
      }
    },
    "owner": "namoong25"
  }
}
