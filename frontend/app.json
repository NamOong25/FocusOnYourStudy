{
  "expo": {
    "name": "FocusYourStudy",
    "slug": "quan-ly-hoc-tap",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "focusyourstudy",
    "icon": "./assets/logo.png",
    "backgroundColor": "#F4FAFD",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.focusyourstudy.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png",
      "name": "FocusYourStudy"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
