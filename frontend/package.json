{
  "name": "quan-ly-hoc-tap",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:schedule": "node --test tests/schedule-read.test.cjs tests/schedule-write.test.cjs tests/schedule-exceptions.test.cjs tests/schedule-overview.test.cjs tests/schedule-reminders.test.cjs",
    "test:exams": "node --test tests/exam-read.test.cjs tests/exam-write.test.cjs tests/exam-overview.test.cjs tests/exam-reminders.test.cjs",
    "build:web": "expo export --platform web",
    "check:dependencies": "expo install --check",
    "test:grades": "node --test tests/grade-*.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^6.0.3"
  }
}
