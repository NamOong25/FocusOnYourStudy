# Maven/Spring Boot do not automatically read this file. Set process environment
# variables, or use scripts/Run-Local.ps1 on Windows for the bundled local setup.
DB_URL=jdbc:postgresql://127.0.0.1:55432/focus_study
DB_USER=focus_study
DB_PASSWORD=replace-with-your-local-password
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8092,http://127.0.0.1:8092
JWT_ISSUER=urn:focus-study:local
# For external deployment use your own persistent RSA keys (PKCS8 private/SPKI public).
# Local scripts generate these under .local/auth and keep them out of Git.
JWT_PRIVATE_KEY_LOCATION=file:.local/auth/private.pem
JWT_PUBLIC_KEY_LOCATION=file:.local/auth/public.pem
# false only for local HTTP; production HTTPS must set true.
AUTH_COOKIE_SECURE=false
