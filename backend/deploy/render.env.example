# Replace every placeholder in Render Dashboard → Environment.
# Render supplies PORT. Add the two PEM files separately under Secret Files.
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-Xmx256m -XX:ActiveProcessorCount=2
DB_URL=jdbc:postgresql://replace-with-neon-direct-host:5432/replace-with-database?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&channelBinding=require
DB_USER=replace-with-neon-role
DB_PASSWORD=replace-with-neon-password
JWT_ISSUER=https://replace-with-service.onrender.com
JWT_PRIVATE_KEY_LOCATION=file:/etc/secrets/private.pem
JWT_PUBLIC_KEY_LOCATION=file:/etc/secrets/public.pem
CORS_ALLOWED_ORIGINS=https://replace-with-web-origin
FORWARD_HEADERS_STRATEGY=NONE
PASSWORD_RESET_ENABLED=false
