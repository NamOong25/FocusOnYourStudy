# Copy to backend/.env.production (ignored). Supply real values outside Git.
# Docker --env-file reads this file. java -jar does not read it automatically.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://replace-with-db-host:5432/focus_study?sslmode=verify-full&sslrootcert=/run/secrets/postgres/root.crt
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
JWT_ISSUER=https://api.replace-with-domain.com
JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt/private.pem
JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt/public.pem
CORS_ALLOWED_ORIGINS=https://app.replace-with-domain.com
AUTH_COOKIE_SECURE=true
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
# Keep NONE until the trusted reverse proxy is known. For NATIVE, set the
# exact TRUSTED_PROXY_IPS regex provided by your deployment/network configuration.
FORWARD_HEADERS_STRATEGY=NONE
PASSWORD_RESET_ENABLED=false
# Enable reset only after setting a real HTTPS frontend URL and SMTP settings.
# PASSWORD_RESET_URL=https://app.your-domain.com/
# PASSWORD_RESET_FROM=FocusYourStudy <noreply@your-domain.com>
# RESET_SMTP_HOST=smtp.your-provider.com
# RESET_SMTP_PORT=587
# RESET_SMTP_USERNAME=replace-with-smtp-user
# RESET_SMTP_PASSWORD=replace-with-smtp-password
# RESET_SMTP_AUTH=true
# RESET_SMTP_STARTTLS=true
